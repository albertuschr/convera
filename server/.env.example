# Salin ke .env lalu isi. JANGAN commit .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DATABASE_URL=postgres://convera:convera@localhost:5432/convera

# 32 byte base64 untuk enkripsi token Meta & secret webhook (AES-256-GCM).
# Buat dengan: npm run gen:key   -- simpan di secret manager untuk production.
ENCRYPTION_KEY=

# Origin frontend yang boleh memanggil API (pisahkan dengan koma). Dipakai untuk CORS dan cek CSRF.
CORS_ORIGINS=http://localhost:5173

SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# false = pendaftaran akun baru ditutup (pakai setelah akun owner pertama dibuat).
REGISTRATION_OPEN=true

# Isi true bila server di belakang reverse proxy (nginx/caddy) agar IP klien terbaca benar.
TRUST_PROXY=false

# Versi Graph API Meta. Cek versi yang masih didukung di dokumentasi Meta sebelum production.
META_GRAPH_VERSION=v26.0

# Khusus development tanpa akses Meta: event dianggap diterima tanpa memanggil Meta. Ditolak saat NODE_ENV=production.
META_MOCK=false
